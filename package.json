{
  "name": "vimtractor",
  "version": "1.0.0",
  "description": "VimTractor - Learn Vim by Playing an Arcade Game",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.js\"",
    "build": "vite build && node scripts/generate-sw.js",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "author": "Michele Melis",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "7.3.7"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "body-parser": "1.20.9",
    "source-map-js": "1.2.2",
    "shell-quote": "1.12.0"
  },
  "packageManager": "npm@11.17.0"
}
